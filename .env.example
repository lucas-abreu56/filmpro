# Copie para `.env` e preencha. O `.env` está no .gitignore — nunca comite.
#
#   cp .env.example .env

# Autentica as chamadas ao webhook do n8n (header `x-api-key`).
# Lida estritamente no servidor: nunca chega ao browser.
N8N_API_KEY=""

# Opcional. Aponte para a URL de teste enquanto o workflow estiver em
# construção; sem isto, usa a URL de produção.
#   https://<seu-n8n>/webhook-test/filmpro/recommendations
N8N_FILMPRO_WEBHOOK=""

# A chave do TMDB NÃO fica aqui. Ela vive só como credencial no n8n
# (httpHeaderAuth, `Authorization: Bearer <v4 read access token>`), porque só o
# workflow chama o TMDB. Passar a chave por query string a expõe em texto claro
# no log de execução do n8n, que é visível na UI — use o header.

# Roda a interface com dados falsos, sem depender do n8n. Só para
# desenvolvimento — a variável não existe em produção.
# NEXT_PUBLIC_FILMPRO_MOCK="1"
