# Copie para `.env` e preencha. O `.env` está no .gitignore — nunca comite.
#
#   cp .env.example .env

# Autentica as chamadas ao webhook do n8n (header `x-api-key`).
# Lida estritamente no servidor: nunca chega ao browser.
N8N_API_KEY=""

# As três URLs abaixo são OBRIGATÓRIAS e não têm mais default no código.
# Tiveram, e o `??` custava duas coisas: publicava o host do n8n num
# repositório que vai a público, e — por só cobrir `undefined` — deixava uma
# variável presente e VAZIA (como as daqui) virar `fetch("")`. Hoje faltando ou
# vazia dá log claro e degradação prevista, em vez de erro confuso.
#
# O host é o do SEU n8n. Em desenvolvimento aponte para `/webhook-test/...`
# enquanto o workflow estiver em construção; em produção, `/webhook/...`.
# Nada disto é preciso com NEXT_PUBLIC_FILMPRO_MOCK=1.

# Curadoria: recebe o texto da pessoa, chama o agente e enriquece no TMDB.
#   https://<seu-n8n>/webhook/filmpro/recommendations
N8N_FILMPRO_WEBHOOK=""

# Standalone: consulta direta de filme por id, usada em /filme/[tmdbId].
#   https://<seu-n8n>/webhook/filmpro/movie
N8N_FILMPRO_MOVIE_WEBHOOK=""

# Fileiras semanais da home (sem LLM, lê home_sections).
#   https://<seu-n8n>/webhook/filmpro/home
N8N_FILMPRO_HOME_WEBHOOK=""

# Só para `scripts/relatorio.mjs` (relatório de produção, somente-leitura).
# A connection string do MESMO banco que o n8n usa. Não é preciso para rodar a
# app nem os testes — só o relatório. O script abre a conexão em modo
# read-only e roda tudo dentro de uma transação READ ONLY.
#   postgresql://usuario:senha@host:5432/filmpro
# DATABASE_URL=""

# A chave do TMDB NÃO fica aqui. Ela vive só como credencial no n8n
# (httpHeaderAuth, `Authorization: Bearer <v4 read access token>`), porque só o
# workflow chama o TMDB. Passar a chave por query string a expõe em texto claro
# no log de execução do n8n, que é visível na UI — use o header.

# Roda a interface com dados falsos, sem depender do n8n. Só para
# desenvolvimento — a variável não existe em produção.
# NEXT_PUBLIC_FILMPRO_MOCK="1"
